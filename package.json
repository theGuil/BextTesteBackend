{
    "name": "BextTeste API",
    "private": false,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dbml": "npx @liam-hq/cli erd build --format liam --input src/documentation/diagrama/schema.json --output-dir dist/erd",
        "test": "node --test --env-file=.env --import tsx/esm 'src/**/*.test.ts'",
        "dev": "node --watch --env-file=.env --import tsx src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.4.3",
        "express": "^5.2.1",
        "jose": "^6.2.1",
        "mongoose": "^9.3.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@liam-hq/cli": "^0.7.24",
        "@types/express": "^5.0.0",
        "@types/node": "^22.13.9",
        "@types/swagger-ui-express": "^4.1.8",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2"
    }
}
